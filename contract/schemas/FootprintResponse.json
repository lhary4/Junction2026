          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "title": "AllergenInfo",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One fact Valio states, with where it comes from and how sure it is. `value` is null when unknown.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "aimo_stock_count",
            "supplier_warehouse",
            "aimo_availability_api",
            "aimo_price_api",
            "gs1_synkka",
            "aimo_delivery_history",
            "product_group_average",
            "none"
          ],
          "title": "Source",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "certainty": {
          "enum": [
            "measured",
            "declared",
            "estimated",
            "unknown"
          ],
          "title": "Certainty",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "source",
        "as_of",
        "certainty"
      ],
      "title": "Claim",
      "type": "object"
    },
