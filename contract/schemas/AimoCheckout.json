{
  "$defs": {
    "AimoExtension": {
      "additionalProperties": false,
      "description": "Everything of ours, under the one extra top-level key `aimo` that UCP's Checkout allows.",
      "properties": {
        "customer": {
          "title": "Customer",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "totals_exclude_tax": {
          "default": true,
          "title": "Totals Exclude Tax",
          "type": "boolean"
        },
        "requested": {
          "items": {
            "$ref": "#/$defs/Need"
          },
          "title": "Requested",
          "type": "array"
        },
        "requested_delivery_date": {
          "format": "date",
          "title": "Requested Delivery Date",
          "type": "string"
        },
        "delivery_date": {
          "format": "date",
          "title": "Delivery Date",
          "type": "string"
        },
        "closing_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closing Time"
        },
        "lines": {
          "additionalProperties": {
            "$ref": "#/$defs/LineClaims"
          },
          "title": "Lines",
          "type": "object"
        },
        "shortfalls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Shortfall"
          },
          "title": "Shortfalls",
          "type": "array"
        },
        "alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "customer",
        "issued_at",
        "requested",
        "requested_delivery_date",
        "delivery_date",
        "lines"
      ],
      "title": "AimoExtension",
      "type": "object"
    },
    "AllergenInfo": {
      "additionalProperties": false,
      "description": "GS1 allergen codes. data='missing' never means 'free from'.",
      "properties": {
        "contains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contains",
          "type": "array"
        },
        "free_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Free From",
          "type": "array"
        },
        "data": {
          "enum": [
            "complete",
            "missing"
          ],
          "title": "Data",
          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "title": "AllergenInfo",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "for_product_id": {
          "title": "For Product Id",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "tier": {
          "enum": [
            "best",
            "better",
            "good"
          ],
          "title": "Tier",
          "type": "string"
        },
        "comparison_price_minor": {
          "title": "Comparison Price Minor",
          "type": "integer"
        },
        "comparison_unit": {
          "title": "Comparison Unit",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "chosen": {
          "title": "Chosen",
          "type": "boolean"
        }
      },
      "required": [
        "for_product_id",
        "product_id",
        "tier",
        "comparison_price_minor",
        "comparison_unit",
        "why",
        "chosen"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Buyer": {
      "additionalProperties": true,
      "description": "Representation of the buyer. Matches UCP types/buyer.json (2026-04-08).",
      "properties": {
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First name of the buyer.",
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last name of the buyer.",
          "title": "Last Name"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Email of the buyer.",
          "title": "Email"
        },
        "phone_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E.164 standard.",
          "title": "Phone Number"
        }
      },
      "title": "Buyer",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One fact Valio states, with where it comes from and how sure it is. `value` is null when unknown.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "aimo_stock_count",
            "supplier_warehouse",
            "aimo_price_api",
            "gs1_synkka",
            "aimo_delivery_history",
            "product_group_average",
            "none"
          ],
          "title": "Source",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "certainty": {
          "enum": [
            "measured",
            "declared",
            "estimated",
            "unknown"
          ],
          "title": "Certainty",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "source",
        "as_of",
        "certainty"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ContentType": {
      "enum": [
        "plain",
        "markdown"
      ],
      "title": "ContentType",
      "type": "string"
    },
    "Item": {
      "description": "Product details for a line item. Matches UCP types/item.json (2026-04-08).",
      "properties": {
        "id": {
          "description": "The product identifier, often the SKU, required to resolve the product details associated with this line item.",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Product title.",
          "title": "Title",
          "type": "string"
        },
        "price": {
          "description": "Unit price in the currency's minor unit as defined by ISO 4217.",
          "minimum": 0,
          "title": "Price",
          "type": "integer"
        },
        "image_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Product image URI.",
          "title": "Image Url"
        }
      },
      "required": [
        "id",
        "title",
        "price"
      ],
      "title": "Item",
      "type": "object"
    },
    "LineClaims": {
      "additionalProperties": false,
      "description": "Our facts for one line item, under aimo.lines[<line item id>].",
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "sales_unit": {
          "title": "Sales Unit",
          "type": "string"
        },
        "base_quantity": {
          "title": "Base Quantity",
          "type": "number"
        },
        "base_unit": {
          "enum": [
            "L",
            "KG",
            "ST"
          ],
          "title": "Base Unit",
          "type": "string"
        },
        "comparison_price_minor": {
          "title": "Comparison Price Minor",
          "type": "integer"
        },
        "comparison_unit": {
          "title": "Comparison Unit",
          "type": "string"
        },
        "substitute_for": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubstituteFor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logistic_model": {
          "enum": [
            "Stock",
            "Terminal"
          ],
          "title": "Logistic Model",
          "type": "string"
        },
        "available_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Date"
        },
        "closing_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closing Time"
        },
        "stock": {
          "$ref": "#/$defs/Claim"
        },
        "price": {
          "$ref": "#/$defs/Claim"
        },
        "origin": {
          "$ref": "#/$defs/Claim"
        },
        "allergens": {
          "$ref": "#/$defs/AllergenInfo"
        },
        "delivery_reliability": {
          "$ref": "#/$defs/Claim"
        },
        "carbon_footprint": {
          "$ref": "#/$defs/Claim"
        },
        "labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "category",
        "sales_unit",
        "base_quantity",
        "base_unit",
        "comparison_price_minor",
        "comparison_unit",
        "logistic_model",
        "stock",
        "price",
        "origin",
        "allergens",
        "delivery_reliability",
        "carbon_footprint"
      ],
      "title": "LineClaims",
      "type": "object"
    },
    "LineItem": {
      "description": "UCP line item (dev.ucp.shopping 2026-04-08). Uses nested item object for product details.",
      "properties": {
        "id": {
          "description": "Unique line-item identifier.",
          "title": "Id",
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/Item"
        },
        "quantity": {
          "description": "Quantity of the item being purchased.",
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "totals": {
          "description": "Per-line-item totals breakdown.",
          "items": {
            "$ref": "#/$defs/Total"
          },
          "title": "Totals",
          "type": "array"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent line item identifier for nested structures.",
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "item",
        "quantity",
        "totals"
      ],
      "title": "LineItem",
      "type": "object"
    },
    "Link": {
      "description": "A typed URL reference for legal compliance or informational links.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "Link",
      "type": "object"
    },
    "Merchant": {
      "description": "Schema defining a Mechant object",
      "properties": {
        "id": {
          "description": "Unique identifier for the merchant.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable name of the merchant.",
          "title": "Name",
          "type": "string"
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Website belonging to the merchant.",
          "title": "Website"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Merchant",
      "type": "object"
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/$defs/MessageError"
        },
        {
          "$ref": "#/$defs/MessageWarning"
        },
        {
          "$ref": "#/$defs/MessageInfo"
        }
      ],
      "description": "Container for error, warning, or info messages. Matches UCP types/message.json (2026-04-08).",
      "title": "Message"
    },
    "MessageError": {
      "description": "Error message. Matches UCP types/message_error.json (2026-04-08).",
      "properties": {
        "type": {
          "const": "error",
          "description": "Message type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "description": "Error code identifying the type of error.",
          "title": "Code",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 9535 JSONPath to the component the message refers to.",
          "title": "Path"
        },
        "content_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentType"
            },
            {
              "type": "null"
            }
          ],
          "default": "plain"
        },
        "content": {
          "description": "Human-readable message.",
          "title": "Content",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "type",
        "code",
        "content",
        "severity"
      ],
      "title": "MessageError",
      "type": "object"
    },
    "MessageInfo": {
      "description": "Informational message. Matches UCP types/message_info.json (2026-04-08).",
      "properties": {
        "type": {
          "const": "info",
          "description": "Message type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RFC 9535 JSONPath to the component the message refers to.",
          "title": "Path"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Info code for programmatic handling.",
          "title": "Code"
        },
        "content_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentType"
            },
            {
              "type": "null"
            }
          ],
          "default": "plain"
        },
        "content": {
          "description": "Human-readable message.",
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "title": "MessageInfo",
      "type": "object"
    },
    "MessageWarning": {
      "description": "Warning message. Matches UCP types/message_warning.json (2026-04-08).",
      "properties": {
        "type": {
          "const": "warning",
          "description": "Message type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSONPath (RFC 9535) to related field.",
          "title": "Path"
        },
        "code": {
          "description": "Warning code.",
          "title": "Code",
          "type": "string"
        },
        "content": {
          "description": "Human-readable warning message.",
          "title": "Content",
          "type": "string"
        },
        "content_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentType"
            },
            {
              "type": "null"
            }
          ],
          "default": "plain"
        },
        "presentation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "notice",
          "description": "Rendering contract: 'notice' or 'disclosure'.",
          "title": "Presentation"
        },
        "image_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to a required visual element.",
          "title": "Image Url"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference URL for more information.",
          "title": "Url"
        }
      },
      "required": [
        "type",
        "code",
        "content"
      ],
      "title": "MessageWarning",
      "type": "object"
    },
    "Need": {
      "additionalProperties": false,
      "description": "What the buyer asked for, in their own unit (litres, kilos or sales units).",
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "unit": {
          "enum": [
            "L",
            "KG",
            "ST"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "amount",
        "unit"
      ],
      "title": "Need",
      "type": "object"
    },
    "Severity": {
      "description": "Reflects the resource state and recommended action.",
      "enum": [
        "recoverable",
        "requires_buyer_input",
        "requires_buyer_review",
        "unrecoverable"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Shortfall": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "requested_base_quantity": {
          "title": "Requested Base Quantity",
          "type": "number"
        },
        "available_base_quantity": {
          "title": "Available Base Quantity",
          "type": "number"
        },
        "missing_base_quantity": {
          "title": "Missing Base Quantity",
          "type": "number"
        },
        "base_unit": {
          "enum": [
            "L",
            "KG",
            "ST"
          ],
          "title": "Base Unit",
          "type": "string"
        },
        "reason": {
          "enum": [
            "partial_stock",
            "out_of_stock",
            "late_delivery",
            "not_found"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "requested_base_quantity",
        "available_base_quantity",
        "missing_base_quantity",
        "base_unit",
        "reason"
      ],
      "title": "Shortfall",
      "type": "object"
    },
    "Status": {
      "description": "Checkout state indicating the current phase.",
      "enum": [
        "incomplete",
        "requires_escalation",
        "ready_for_complete",
        "complete_in_progress",
        "completed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    },
    "SubstituteFor": {
      "additionalProperties": false,
      "description": "The product a substitute line replaces, signed with the quote so the harness can compare.",
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "allergens": {
          "$ref": "#/$defs/AllergenInfo"
        }
      },
      "required": [
        "product_id",
        "name",
        "category",
        "allergens"
      ],
      "title": "SubstituteFor",
      "type": "object"
    },
    "Total": {
      "description": "A cost breakdown entry with a category, amount, and optional display text.",
      "properties": {
        "type": {
          "description": "Cost category: subtotal, discount, items_discount, fulfillment, tax, fee, total.",
          "title": "Type",
          "type": "string"
        },
        "display_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Text"
        },
        "amount": {
          "description": "Signed amount in minor currency units.",
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "amount"
      ],
      "title": "Total",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "UCP's Checkout as typed by the AP2 SDK, plus our `aimo` key. No SDK field is renamed or removed.",
  "properties": {
    "id": {
      "description": "Unique identifier of the checkout session.",
      "title": "Id",
      "type": "string"
    },
    "merchant": {
      "anyOf": [
        {
          "$ref": "#/$defs/Merchant"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The merchant associated with the checkout."
    },
    "line_items": {
      "description": "Array of line items in the checkout.",
      "items": {
        "$ref": "#/$defs/LineItem"
      },
      "title": "Line Items",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "currency": {
      "description": "ISO-4217 3-letter alphabetic currency code.",
      "title": "Currency",
      "type": "string"
    },
    "totals": {
      "description": "Pricing breakdown. Must contain exactly one subtotal and one total entry.",
      "items": {
        "$ref": "#/$defs/Total"
      },
      "title": "Totals",
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "buyer": {
      "anyOf": [
        {
          "$ref": "#/$defs/Buyer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Representation of the buyer."
    },
    "messages": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Message"
