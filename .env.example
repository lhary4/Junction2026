# Copy to .env and fill in. Values are shared in the team chat, never committed.

# Key for the Valio Aimo mock APIs, see contexte/challenge-1-valio-aimo.md
VALIO_AIMO_API_KEY=

# Key for Gemini Decision, the judge used by the harness (Google AI Studio)
GEMINI_API_KEY=

# live: call the Valio APIs, on the real clock.
# replay: serve the answers recorded in contract/fixtures/valio/, with the clock frozen at the recording time.
VALIO_MODE=replay

# Optional. An ISO time that replaces the clock in both modes, for example 2026-11-15T16:59:00+02:00
AIMO_FROZEN_NOW=

# Optional. Where the three data files live (default: data/)
AIMO_DATA_DIR=

# Optional. Where the gateway writes its quotes, orders and audit log (default: state/)
AIMO_STATE_DIR=

# Optional. Where the two services run (defaults shown)
MERCHANT_URL=http://localhost:8001
HARNESS_URL=http://localhost:8002

# Optional. Telegram bot alert sent by the harness when an order needs human approval on the page.
# Leave empty to skip notifications; approving and signing always happen on the web page, never in chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
